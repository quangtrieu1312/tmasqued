# LOG_LEVEL and ENABLE_STATISTIC are hot-reloaded when this file is saved (no restart
# needed). Every other key is read once at startup and needs a restart to change.
# (Comments must be on their own line — an inline "KEY=val # note" makes "# note" part
# of the value.)
LOG_LEVEL=info
WAN_INTERFACE=eth0
BIND_ADDR=0.0.0.0
LISTEN_PORT=443
VIRT_CIDR=100.64.0.1/10
TUNNEL_MTU=1413
SAN_DNS_LIST=iiiii.info,*.iiiii.info
SAN_IP_LIST=1.1.1.1,8.8.4.4,8.8.8.8
# ENABLE_STATISTIC=true turns on the "[STATISTIC]" packet-trace diagnostics, the
# per-packet observers, and the pprof/expvar endpoint on :6060. Off by default.
ENABLE_STATISTIC=false
# LOG_PACKET=true dumps every packet's payload (extremely verbose; debugging only).
LOG_PACKET=false
# Upload-forward egress. Mutually exclusive; DEFAULT = tun-GSO (best aggregate across all
# measured NIC regimes; ~2-4x AF_XDP-TX on single-queue NICs, equal under full RSS).
# FORWARD_TUN_GSO=true (default) coalesces upload TCP into TSO super-frames written to the
#   main tun (opened IFF_VNET_HDR) so the kernel host-TSO-segments + ip_forwards them.
#   Set FORWARD_TUN_GSO=false explicitly for the raw AF_XDP-TX egress.
# FORWARD_TUN_VHOST=true forwards via a vhost-net-fronted TAP (kernel GRO) instead
#   (disables the GSO default automatically).
# The upload resequencer (FORWARD_UPLOAD_RESEQ) defaults ON whenever a coalescing
# egress (GSO/vhost) is active; override here or via env.
#FORWARD_TUN_GSO=true
#FORWARD_TUN_VHOST=false

# --- Advanced datapath tuning (all optional; defaults shown; restart to change) ---
# Pin the forward-writer goroutine to a fixed CPU (LockOSThread + sched_setaffinity).
# Aimed at RSS-less virtio (stabilizes CPU->txq->host RX steering). A/B measured it
# neutral at RSS and inconclusive under single-queue, so DEFAULT OFF. Set true to try.
#FORWARD_WRITER_PIN=false
# AF_XDP RX poll timeout (ms). 0 = busy-poll (one core hot, lowest wake jitter for a
# single low-rate flow); >0 = block-and-yield. Default 5.
#XDP_RX_POLL_MS=5
# XDP need-wakeup flag on the TX path. Default true.
#XDP_NEED_WAKEUP=true
# TUN read-goroutine count. Default = number of CPUs. Set 1 to serialize tun ingest.
#TUN_QUEUES=
# Run QUIC on a kernel UDP socket instead of AF_XDP (forward-return still uses AF_XDP).
# Default false.
#QUIC_KERNEL_UDP=false
# Route small inner-TCP ACKs (<128B) via the kernel raw socket so their timing stays
# clean (bulk stays on the forward egress). Default true.
#FORWARD_ACK_VIA_SOCKET=true
# Route XDP-eligible forwarded packets via AF_PACKET (kernel qdisc TX) not AF_XDP.
# Default false.
#FORWARD_KERNEL_TX=false
# io_uring-batched writes on the IFF_NAPI forward TUN. Default false.
#FORWARD_TUN_URING=false
# Forward via an IFF_NAPI TUN (kernel GRO + host-TSO). Default false.
#FORWARD_TUN_NAPI=false
# Disable GSO coalescing on the tun-GSO egress. Default false.
#FORWARD_TUN_NOCOALESCE=false
# Max segments per GSO super-frame (1..64). Default 64.
#FORWARD_TUN_GSO_MAXSEGS=64
# Idle (microseconds) before an open GSO super-frame is flushed. Default 120.
#FORWARD_TUN_GSO_FLUSH_IDLE_US=120
# Upload-path inner-TCP-seq resequencer (needed for clean GSO/GRO coalescing).
# Default ON whenever a coalescing egress (tun-GSO/vhost) is active; set true/false
# to force.
#FORWARD_UPLOAD_RESEQ=
# Resequencer window: max buffered out-of-order segments per flow. Default 64.
#FORWARD_UPLOAD_RESEQ_WINDOW=64
# Resequencer max age (microseconds) before a stalled flow is flushed. Default 2000.
#FORWARD_UPLOAD_RESEQ_MAXAGE_US=2000
